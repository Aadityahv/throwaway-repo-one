namespace cooperative_groups { namespace __v1 {

namespace details {

template <typename TyVal, typename TyOp, unsigned int TySize, typename ParentT>
__inline__ __attribute__((always_inline)) __attribute__((device)) auto coalesced_reduce(const __single_warp_thread_block_tile<TySize, ParentT>& group,
                                    TyVal&& val,
                                    TyOp&& op) -> decltype(op(val, val)) {
    auto out = val;
    for (int mask = TySize >> 1; mask > 0; mask >>= 1) {
        out = op(out, group.shfl_xor(out, mask));
    }

    return out;
}

template <typename TyVal, typename TyOp>
__inline__ __attribute__((always_inline)) __attribute__((device)) auto coalesced_reduce(const coalesced_group& group, TyVal&& val, TyOp&& op) -> decltype(op(val, val)) {
    if (group.size() == 32) {

        auto tile = details::tiled_partition_internal<32, void>();
        return coalesced_reduce(tile, cuda::std::forward<TyVal>(val), cuda::std::forward<TyOp>(op));
    }
    else {
        auto scan_result =
            inclusive_scan_non_contiguous(group, cuda::std::forward<TyVal>(val), cuda::std::forward<TyOp>(op));
        unsigned int group_mask = _coalesced_group_data_access::get_mask(group);
        unsigned int last_thread_id = 31 - __clz(group_mask);
        return details::tile::shuffle_dispatch<TyVal>::shfl(
            cuda::std::forward<TyVal>(scan_result), group_mask, last_thread_id, 32);
    }
}

}

