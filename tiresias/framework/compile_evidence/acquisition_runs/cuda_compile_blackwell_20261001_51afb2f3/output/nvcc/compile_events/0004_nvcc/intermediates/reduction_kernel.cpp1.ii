__inline__ __half2 __hcmadd(const __half2 a, const __half2 b, const __half2 c)
{




    __half real_tmp = __hfma(a.x, b.x, c.x);
    __half img_tmp = __hfma(a.x, b.y, c.y);
    real_tmp = __hfma(__hneg(a.y), b.y, real_tmp);
