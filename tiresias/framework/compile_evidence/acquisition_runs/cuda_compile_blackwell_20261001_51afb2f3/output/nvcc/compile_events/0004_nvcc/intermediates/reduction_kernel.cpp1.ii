namespace __find_detail
{
static constexpr size_t __not_found = ~size_t(0);
static constexpr size_t __ambiguous = __not_found - 1;

[[nodiscard]] 
# 63 "/usr/local/cuda-13.2/targets/x86_64-linux/include/cccl/cuda/std/__tuple_dir/get.h"
             __attribute__((host)) __attribute__((device)) 
