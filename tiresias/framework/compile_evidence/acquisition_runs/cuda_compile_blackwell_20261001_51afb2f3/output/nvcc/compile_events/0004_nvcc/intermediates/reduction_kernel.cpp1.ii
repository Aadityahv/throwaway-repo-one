             __attribute__((__visibility__("hidden"))) constexpr size_t __find_idx_return(size_t __curr_i, size_t __res, bool __matches) noexcept
{
  return !__matches ? __res : (__res == __not_found ? __curr_i : __ambiguous);
}

template <size_t _Nx>
[[nodiscard]] 
# 69 "/usr/local/cuda-13.2/targets/x86_64-linux/include/cccl/cuda/std/__tuple_dir/get.h"
