namespace cooperative_groups { namespace __v1 {

namespace details {

    template <typename Group>
    struct _elect_group_supported : cuda::std::false_type {};

    template<>
    struct _elect_group_supported<coalesced_group> : cuda::std::true_type {};
    template<unsigned int Size, typename Parent>
    struct _elect_group_supported<thread_block_tile<Size, Parent>> :
        cuda::std::integral_constant<bool, (Size == 32)> {};


    template <typename Group>
    struct elect_group_supported : public _elect_group_supported<details::remove_qual<Group>> {};

    template<typename Group>
    static __inline__ __attribute__((always_inline)) __attribute__((device)) bool elect_one(const Group& group, unsigned int mask, unsigned int& leader_lane) {
        int is_leader = 0;

        asm("{\n\t"
          " .reg .pred p;\n\t"
          "  elect.sync %0|p, %2;\n\t"
          " @p mov.s32 %1, 1;\n\t"
          "}"
          : "+r"(leader_lane), "+r"(is_leader) : "r" (mask));

        return is_leader;
    }

    template<bool UseElect>
    struct invoke_one_impl {};

    template<>
    struct invoke_one_impl<true> {
        template<typename Group, typename Fn, typename... Args>
        static __inline__ __attribute__((always_inline)) __attribute__((device)) void invoke_one(const Group& group, Fn&& fn, Args&&... args) {
            auto mask = details::_coalesced_group_data_access::get_mask(group);
            unsigned int leader_lane = 0;

            if (elect_one(group, mask, leader_lane)) {
                cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...);
            }
        }

        template<typename Group, typename Fn, typename... Args>
        static __inline__ __attribute__((always_inline)) __attribute__((device)) auto invoke_one_broadcast(const Group& group, Fn&& fn, Args&&... args)
                -> typename cuda::std::remove_reference<
                    decltype(cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...))>::type {

            using ResultType = decltype(cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...));
            details::remove_qual<ResultType> result;
            auto mask = details::_coalesced_group_data_access::get_mask(group);
            unsigned int leader_lane = 0;

            if (elect_one(group, mask, leader_lane)) {
                result = cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...);
            }


            return tile::shuffle_dispatch<ResultType>::shfl(result, mask, leader_lane, 32);
        }
    };

    template<>
    struct invoke_one_impl<false> {
        template<typename Group, typename Fn, typename... Args>
        static __inline__ __attribute__((always_inline)) __attribute__((device)) void invoke_one(const Group& group, Fn&& fn, Args&&... args) {
            if (group.thread_rank() == 0) {
                cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...);
            }
        }

        template<typename Group, typename Fn, typename... Args>
        static __inline__ __attribute__((always_inline)) __attribute__((device)) auto invoke_one_broadcast(const Group& group, Fn&& fn, Args&&... args)
                -> typename cuda::std::remove_reference<
                    decltype(cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...))>::type {

            using ResultType = decltype(cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...));
            details::remove_qual<ResultType> result;

            if (group.thread_rank() == 0) {
                result = cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...);
            }

            return group.shfl(result, 0);
        }
    };


};

template<typename Group, typename Fn, typename... Args>
__inline__ __attribute__((always_inline)) __attribute__((device)) void invoke_one(const Group& group, Fn&& fn, Args&&... args) {
    using impl = details::invoke_one_impl<details::elect_group_supported<Group>::value>;
    impl::invoke_one(group, cuda::std::forward<Fn>(fn), cuda::std::forward<Args>(args)...);
}

template<typename Fn, typename... Args>
__inline__ __attribute__((always_inline)) __attribute__((device)) auto invoke_one_broadcast(const coalesced_group& group, Fn&& fn, Args&&... args)
        -> typename cuda::std::remove_reference<
            decltype(cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...))>::type {

    using ResultType = decltype(cuda::std::forward<Fn>(fn)(cuda::std::forward<Args>(args)...));
    static_assert(!cuda::std::is_same<ResultType, void>::value,
                  "For invocables returning void invoke_one should be used instead");
    using impl = details::invoke_one_impl<details::elect_group_supported<coalesced_group>::value>;
    return impl::invoke_one_broadcast(group,
                                      cuda::std::forward<Fn>(fn),
                                      cuda::std::forward<Args>(args)...);
}

template<unsigned int Size, typename Parent, typename Fn, typename... Args>
__inline__ __attribute__((always_inline)) __attribute__((device)) auto invoke_one_broadcast(const thread_block_tile<Size, Parent>& group, Fn&& fn, Args&&... args)
        -> typename cuda::std::remove_reference<
