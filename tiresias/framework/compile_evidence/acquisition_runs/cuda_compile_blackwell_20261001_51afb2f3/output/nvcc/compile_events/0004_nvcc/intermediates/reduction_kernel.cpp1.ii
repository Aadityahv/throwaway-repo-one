template <class T> struct SharedMemory
{
    __attribute__((device)) inline operator T *()
    {
        extern __attribute__((shared)) int __smem[];
        return (T *)__smem;
    }

    __attribute__((device)) inline operator const T *() const
    {
        extern __attribute__((shared)) int __smem[];
        return (T *)__smem;
    }
};



template <> struct SharedMemory<double>
{
    __attribute__((device)) inline operator double *()
    {
        extern __attribute__((shared)) double __smem_d[];
        return (double *)__smem_d;
    }

    __attribute__((device)) inline operator const double *() const
    {
        extern __attribute__((shared)) double __smem_d[];
        return (double *)__smem_d;
    }
};

template <class T> __attribute__((device)) __inline__ __attribute__((always_inline)) T warpReduceSum(unsigned int mask, T mySum)
{
    for (int offset = warpSize / 2; offset > 0; offset /= 2) {
        mySum += __shfl_down_sync(mask, mySum, offset);
    }
    return mySum;
}




template <> __attribute__((device)) __inline__ __attribute__((always_inline)) int warpReduceSum<int>(unsigned int mask, int mySum)
{
    mySum = __reduce_add_sync(mask, mySum);
    return mySum;
}
